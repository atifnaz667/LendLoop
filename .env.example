# Next.js app (.env.local). Copy this file to .env.local and fill in values.
# Only NEXT_PUBLIC_* values reach the browser.

# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk (Dashboard > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# ---------------------------------------------------------------------------
# Convex deployment variables. These are NOT read from this file.
# Set them on the Convex deployment with `npx convex env set NAME value`:
#
#   CLERK_FRONTEND_API_URL      https://your-app.clerk.accounts.dev
#   CLERK_WEBHOOK_SIGNING_SECRET whsec_replace-me
#   N8N_REQUEST_WEBHOOK_URL     https://your-tunnel.trycloudflare.com/webhook/lendloop-request-events
#   LENDLOOP_TO_N8N_SECRET      (openssl rand -hex 32)
#   N8N_TO_LENDLOOP_SECRET      (openssl rand -hex 32)
# ---------------------------------------------------------------------------

# n8n container environment. Copy to n8n/.env (git ignored) and fill in values.

# Encrypts credentials stored in n8n. Generate once: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-me

# Timezone used by the daily overdue reminder schedule
GENERIC_TIMEZONE=UTC

# Convex HTTP actions base URL (note: .convex.site, not .convex.cloud)
LENDLOOP_CONVEX_SITE_URL=https://your-deployment.convex.site

# Shared secrets. Must match the values set on the Convex deployment.
LENDLOOP_TO_N8N_SECRET=replace-me
N8N_TO_LENDLOOP_SECRET=replace-me
